{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observed_at_utc", "gold_publication", "provenance", "customers", "contents", "distributors", "existing_offer_context"],
  "properties": {
    "schema_version": {"const": 1},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "gold_publication": {"type": "string", "minLength": 1},
    "provenance": {"type": "string", "minLength": 1},
    "customers": {
      "type": "array", "minItems": 3, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["customer_key", "name", "territory", "salesforce_contact_id"],
        "properties": {
          "customer_key": {"$ref": "#/$defs/key"},
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "territory": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "salesforce_contact_id": {"type": "string", "pattern": "^003[A-Za-z0-9]{12}([A-Za-z0-9]{3})?$"}
        }
      }
    },
    "contents": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["content_key", "title", "distributor_key"],
        "properties": {
          "content_key": {"$ref": "#/$defs/key"},
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "distributor_key": {"$ref": "#/$defs/key"}
        }
      }
    },
    "distributors": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["distributor_key", "name", "sap_partner_code"],
        "properties": {
          "distributor_key": {"$ref": "#/$defs/key"},
          "name": {"type": "string", "minLength": 1, "maxLength": 300},
          "sap_partner_code": {"type": ["string", "null"], "maxLength": 80}
        }
      }
    },
    "existing_offer_context": {
      "type": "object", "additionalProperties": false,
      "required": ["territory", "currency", "rental_minor", "purchase_minor", "tax_basis", "policy"],
      "properties": {
        "territory": {"const": "FR"},
        "currency": {"const": "EUR"},
        "rental_minor": {"type": "integer", "minimum": 0},
        "purchase_minor": {"type": "integer", "minimum": 0},
        "tax_basis": {"type": "string", "minLength": 1},
        "policy": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "key": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{0,127}$"}
  }
}
