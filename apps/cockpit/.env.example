# Merge these keys into the ignored rayfin/.env, or set them in the shell.
# RAYFIN_ENV_FILE selects an alternate private env file for Rayfin and the tools.
# Do not put them in the generated .env.local or prefix them with VITE_/RAYFIN_PUBLIC_.

# Independently approved UUIDs for native-readback.mjs and verify-flixy.mjs.
# Do not derive these pins from the active deployment registry or SQL binding.
COCKPIT_EXPECTED_TENANT_ID=
COCKPIT_EXPECTED_WORKSPACE_ID=
COCKPIT_EXPECTED_APP_ID=

# Exact allowed published app origin, without a path, query or trailing slash.
# Required by rayfin/rayfin.yml; no wildcard or default origin is used.
COCKPIT_ALLOWED_REDIRECT_URI=

# Project/contact URL for the artwork recovery User-Agent, not an asset license.
# Use an HTTPS URL without credentials, query or fragment; --project-url overrides it.
COCKPIT_ARTWORK_PROJECT_URL=
